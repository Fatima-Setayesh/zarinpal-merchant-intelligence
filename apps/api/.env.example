# Network binding for the API server.
API_HOST=127.0.0.1
API_PORT=3000

# Required when API_HOST is not loopback. Generate a unique secret of at least
# 32 characters and send it as `Authorization: Bearer <token>`.
API_AUTH_TOKEN=

# Allowed browser origin. Use * only for non-credentialed local development.
CORS_ORIGIN=http://localhost:5173

# Optional path to the payments dataset. When empty, the API starts in a
# degraded state and data-dependent endpoints report that data is unavailable.
PAYMENTS_DATA_PATH=
